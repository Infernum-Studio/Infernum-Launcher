{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infernum Launcher",
  "version": "1.0.0",
  "identifier": "studio.infernum.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Infernum Launcher",
        "width": 1100,
        "height": 680,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: https://infernum-packs.pages.dev",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "category": "Game",
    "shortDescription": "Launcher de Infernum Studio",
    "license": "GPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
